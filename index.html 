}

.nav{
    max-width:1150px;
    margin:auto;
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.logo{
    font-size:21px;
    font-weight:bold;
}

.nav-links{
    display:flex;
    gap:18px;
}

.nav-links a{
    color:white;
    text-decoration:none;
    font-size:14px;
}

/* HERO */

.hero{
    min-height:560px;
    display:flex;
    justify-content:center;
    align-items:center;
    text-align:center;
    color:white;
    padding:30px 20px;

    background:
    linear-gradient(#0008,#0009),
    linear-gradient(135deg,#2563eb,#111827);
}

.hero h1{
    font-size:clamp(38px,9vw,75px);
    margin-bottom:15px;
}

.hero h2{
    font-size:clamp(20px,5vw,32px);
    margin-bottom:15px;
}

.hero p{
    color:#e5e7eb;
    line-height:1.7;
    max-width:650px;
    margin:auto;
}

.buttons{
    margin-top:30px;
}

.btn{
    display:inline-block;
    padding:14px 24px;
    margin:5px;
    border-radius:8px;
    text-decoration:none;
    font-weight:bold;
}

.btn-yellow{
    background:#facc15;
    color:#111;
}

.btn-green{
    background:#22c55e;
    color:white;
}

/* COMMON */

section{
    max-width:1150px;
    margin:auto;
    padding:60px 18px;
}

.title{
    text-align:center;
    font-size:32px;
    color:#102a72;
    margin-bottom:35px;
}

/* COURSES */

.category{
    margin-bottom:35px;
}

.category-title{
    background:linear-gradient(135deg,#172554,#2563eb);
    color:white;
    padding:15px 18px;
    border-radius:10px;
    margin-bottom:15px;
    font-size:21px;
}

.course-grid{
    display:grid;
    grid-template-columns:
    repeat(auto-fit,minmax(180px,1fr));
    gap:12px;
}

.course{
    background:white;
    padding:17px;
    border-radius:10px;
    border:1px solid #e5e7eb;
    box-shadow:0 3px 12px #0000000d;
    transition:.25s;
}

.course:hover{
    transform:translateY(-4px);
    box-shadow:0 7px 20px #0002;
}

.course h3{
    color:#1d4ed8;
    font-size:16px;
    margin-bottom:7px;
}

.course p{
    font-size:13px;
    color:#667085;
}

/* ABOUT */

.about{
    background:white;
    padding:30px;
    border-radius:15px;
    box-shadow:0 5px 20px #0001;
    line-height:1.8;
}

/* MANAGER */

.manager{
    display:flex;
    justify-content:center;
}

.manager-card{
    background:white;
    width:100%;
    max-width:450px;
    text-align:center;
    padding:30px;
    border-radius:18px;
    box-shadow:0 5px 20px #0001;
}

.manager-icon{
    width:90px;
    height:90px;
    margin:auto auto 15px;
    border-radius:50%;
    background:#2563eb;
    color:white;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:38px;
}

/* INFO */

.info-grid{
    display:grid;
    grid-template-columns:
    repeat(auto-fit,minmax(220px,1fr));
    gap:18px;
}

.info{
    background:white;
    padding:25px;
    border-radius:15px;
    box-shadow:0 5px 18px #0001;
}

.info h3{
    color:#2563eb;
    margin-bottom:10px;
}

/* CONTACT */

.contact{
    max-width:none;
    background:#10204a;
    color:white;
    text-align:center;
}

.contact .title{
    color:white;
}

.contact p{
    margin:10px;
    font-size:17px;
}

/* FOOTER */

footer{
    background:#080f25;
    color:#9ca3af;
    text-align:center;
    padding:25px;
}

/* MOBILE */

@media(max-width:650px){

    .nav{
        flex-direction:column;
        gap:12px;
    }

    .nav-links{
        gap:10px;
    }

    .nav-links a{
        font-size:12px;
    }

    .hero{
        min-height:520px;
    }

    section{
        padding:45px 12px;
    }

    .title{
        font-size:27px;
    }

    .course-grid{
        grid-template-columns:
        repeat(2,1fr);
    }

    .course{
        padding:13px;
    }

    .course h3{
        font-size:14px;
    }
}

@media(max-width:380px){

    .course-grid{
        grid-template-columns:1fr;
    }
}
</style>
